  "item": [
    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let jsonData = pm.response.json();\nlet createdBoardName = pm.environment.get(\"myBoardName\");\n\npm.environment.set(\"myBoardID\", jsonData.id);\npm.environment.set(\"myBoardName\", jsonData.name);\n\npm.test(\"Response contains id\", function () {\n    pm.expect(jsonData).to.have.property(\"id\");\n});\n\npm.test(\"Response contains name\", function () {\n    pm.expect(jsonData).to.have.property(\"name\");\n});\n\npm.test(\"Response contains url\", function () {\n    pm.expect(jsonData).to.have.property(\"url\");\n});\npm.test(\"Correct board name\", function () {\n    pm.expect(jsonData.name).to.eql(createdBoardName);\n});\n\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a random 3-digit number\nlet randomNum = Math.floor(Math.random() * 1000)\n    .toString().padStart(3, '0');\n\n// Create the dynamic value\nlet uniqueValue = `myboard${randomNum}`;\n\n// Set it as an environment variable\npm.environment.set(\"myBoardName\", uniqueValue);\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseURL}}1/boards/?key={{keyAPI}}&token={{token}}&name={{myBoardName}}",
          "host": [
            "{{baseURL}}1"
          ],
          "path": [
            "boards",
            ""
          ],
          "query": [
            {
              "key": "key",
              "value": "{{keyAPI}}"
            },
            {
              "key": "token",
              "value": "{{token}}"
            },
            {
              "key": "name",
              "value": "{{myBoardName}}"
            }
          ]
        },
        "description": "Generated from cURL: curl --request POST \\\n  --url 'https://api.trello.com/1/boards/?name={name}' \\\n  --header 'Authorization: Bearer <access_token>'"
